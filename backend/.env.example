APP_ENV=development
LOG_LEVEL=INFO

# LLM (Google AI Studio -> https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0

# Langfuse (Cloud -> https://cloud.langfuse.com, Settings > API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Base de datos
DATABASE_URL=sqlite:///./data/shop.db
MAX_SQL_RETRIES=3
MAX_ROWS=100

SQL_TIMEOUT_SECONDS=5

# Frontend (Vite usa el puerto 5173). Las listas van en formato JSON.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_PER_MINUTE=10